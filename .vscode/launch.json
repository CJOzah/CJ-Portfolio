{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Portfolio (Chrome)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": ["--no-web-resources-cdn"]
    },
    {
      "name": "Portfolio (Chrome, profile)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": ["--no-web-resources-cdn"],
      "flutterMode": "profile"
    },
    {
      "name": "Portfolio (Chrome, release)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": ["--no-web-resources-cdn"],
      "flutterMode": "release"
    },
    {
      "name": "Sync projects snapshot",
      "type": "dart",
      "request": "launch",
      "program": "tool/build_projects.dart",
      // Export PORTFOLIO_GITHUB_TOKEN in your shell first; never commit it.
      "env": { "PORTFOLIO_GITHUB_TOKEN": "${env:PORTFOLIO_GITHUB_TOKEN}" }
    },
    {
      "name": "Flutter tests",
      "type": "dart",
      "request": "launch",
      "program": "test/"
    }
  ]
}
