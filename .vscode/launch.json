{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Portfolio (Chrome)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "deviceId": "chrome"
    },
    {
      "name": "Portfolio (Chrome, profile)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "flutterMode": "profile"
    },
    {
      "name": "Portfolio (Chrome, release)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "flutterMode": "release"
    },
    {
      "name": "Portfolio (Chrome + local proxy)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": ["--dart-define=GITHUB_PROXY_URL=http://localhost:3000/api/github-proxy"]
    },
    {
      "name": "GitHub proxy (api/)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/api/server.js",
      "cwd": "${workspaceFolder}/api",
      // Put GITHUB_TOKEN=... in api/.env (gitignored). Run `npm install` in api/ once.
      "envFile": "${workspaceFolder}/api/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "Flutter tests",
      "type": "dart",
      "request": "launch",
      "program": "test/"
    }
  ],
  "compounds": [
    {
      "name": "Portfolio + proxy",
      "configurations": ["GitHub proxy (api/)", "Portfolio (Chrome + local proxy)"],
      "stopAll": true
    }
  ]
}
